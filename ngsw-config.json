{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "dataGroups": [
    {
      "name": "productApis",
      "urls": [
        "https://admin.kubona.ng/api/Product/**",
        "https://admin.kubona.ng/Product/Products/**",
        "https://admin.kubona.ng/api/**"
      ],
      "cacheConfig": {
        "maxSize": 200,
        "maxAge": "6h",
        "strategy": "performance",
        "timeout": "5s",
        "cacheOpaqueResponses": true
      },
      "cacheQueryOptions": {
        "ignoreSearch": true
      }
    }
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
